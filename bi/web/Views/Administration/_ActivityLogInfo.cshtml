<div id="activitylog-info-popup" class="fluent-popup custom-bootstrap-styles custom-server-style" style="display:none">
    <div class="fluent-item-popup-body" id="dialog-content">
        <span class="col-12 activity-log-summary">
            <label class="activity-log-label">@T["Summary"]</label>
            <span id="activitylog-summary" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 activity-log-date">
            <label class="activity-log-label">@T["Timestamp"]</label>
            <span id="activitylog-timestamp" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 activity-log-username">
            <label class="activity-log-label">@T["Performed By"]</label>
            <span id="activitylog-performed-by" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 activity-log-email">
            <label class="activity-log-label">@T["User Email"]</label>
            <span id="activitylog-email" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 activity-log-ipaddress">
            <label class="activity-log-label">@T["IP Address"]</label>
            <span id="activitylog-ipaddress" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 activity-log-event-type">
            <label class="activity-log-label">@T["Event Category"]</label>
            <span id="activitylog-event-category" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 activity-log-event-category">
            <label class="activity-log-label">@T["Event Type"]</label>
            <span id="activitylog-event-type" class="activity-log-detail">-</span>
        </span>
        <span id="activitylog-source-section" class="col-12 activity-log-source d-none">
            <label class="activity-log-label">@T["Source"]</label>
            <span id="activitylog-source" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 activity-log-user-agent no-margin no-padding">
            <label class="activity-log-label">@T["User Agent"]</label>
            <span id="activitylog-user-agent" class="activity-log-detail">-</span>
        </span>
        <div id="activitylog-change-summary" class="col-12 no-margin no-padding d-none">
            <span class="col-12 horizontal-line"></span>
            <label class="changes-logs-label">@T["Change Summary"]</label>
            <div id="activitylog-change-details" class="col-12 no-margin no-padding"></div>
        </div>
        <div id="activitylog-action-summary" class="col-12 no-margin no-padding d-none">
            <span class="col-12 horizontal-line"></span>
            <label class="changes-logs-label">@T["Action Summary"]</label>
            <div id="activitylog-action-details" class="col-12 no-margin no-padding"></div>
        </div>
    </div>
</div>
