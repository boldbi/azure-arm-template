<div id="emaillog-info-popup" class="fluent-popup custom-bootstrap-styles custom-server-style" style="display: none">
    <div class="fluent-item-popup-body">
        <span class="email-log-event">
            <label class="info-label">@T["Event"]</label> <span id="emaillog-event">-</span>
        </span>
        <span class="email-log-date">
            <label class="info-label">@T["Date"]</label> <span id="emaillog-date">-</span>
        </span>
        <span class="email-log-status">
            <label class="info-label">@T["Status"]</label> <span id="emaillog-status">-</span>
        </span>
        <span class="email-log-recipient">
            <label class="info-label">@T["Recipient"]</label> <span id="emaillog-recipient" data-bs-toggle="tooltip" title="-">-</span>
        </span>
        <span class="email-log-initiated">
            <label class="info-label">@T["Initiated By"]</label> <span id="emaillog-initiated" data-bs-toggle="tooltip" title="-">-</span>
        </span>
        <div id="mail-error-container" class="mail-error-message d-none">
            <label class="info-label">@T["Error Message"]</label>
            <div id="mail-error-message" class="form-control" name="text" readonly>-</div>
        </div>
        <div class="mail-body">
            <label class="info-label">@T["Email Message"]</label>
            <div id="mail-body" class="form-control" name="text" readonly >-</div>
        </div>
    </div>
</div>