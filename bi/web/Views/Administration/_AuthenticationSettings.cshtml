            <div class="bi-page-content col-12 no-padding">
                <div class="tab-content col-12 no-padding">
                    @if (isSelfHosted && (isAdmin || (model != null && (model[SettingsScopes.All] || model[SettingsScopes.AuthenticationSettings]))))
                    {
                        @await Html.PartialAsync("_DefaultAuthentication")
                    }

                    @if (isAdmin || (model != null && (model[SettingsScopes.All] || model[SettingsScopes.AuthenticationSettings])))
                    {
                        @if (isSelfHosted)
                        {
                            <div role="tabpanel" class="tab-pane col-12 no-padding" id="auth-control">
                                <div id="auth-control-body" class="col-12 bi-page-body">
                                    <form id="auth-control-form" name="authControlForm" class="form-top-margin col-12 no-padding" method="post" enctype="multipart/form-data" autocomplete="off">
                                        <div class="col-12 checkbox-bottom no-padding">
