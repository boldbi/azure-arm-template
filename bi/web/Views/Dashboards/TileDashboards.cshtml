                                                <div class="dashboard-info-section-2 col-12 no-padding no-margin display-none" data-dashboard-visibility="tile-info-section2">
                                                    <div class="col-4 no-padding profile-section display-none" data-dashboard-visibility="upload-profile-section">
                                                        <span class="author-name no-padding no-margin">
                                                            <span class="su su-created-by"></span>
                                                            <span data-dashboard-field="created-by"></span>
                                                        </span>                                                  
                                                    </div>
                                                    <div class="col-4 no-padding category-section">
                                                        <span class="category-name no-padding no-margin">
                                                            <span class="category-icon su su-categoried-dashboard"></span>
                                                            <span data-dashboard-field="category-name"></span>
                                                        </span>
                                                    </div>
                                                    <div class="col-4 no-padding modifieddate-section" data-dashboard-visibility="upload-modified-section">
                                                        <span class="modified-date no-padding no-margin display-none" data-dashboard-visibility="upload-modified-date">
                                                            <span class="su su-clock clock-listing-icon modified-date no-margin display-none" data-dashboard-visibility="upload-modified-date-clock"></span>
                                                                <span data-dashboard-field="modified-date"></span>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </li>
                                        <li class="col-12 no-padding display-none" data-dashboard-visibility="append-loading">
                                            <div class="fd-post">
                                                <div class="fd-place-holder">
                                                    <div class="fd-divider-1"></div>
                                                    <div class="fd-divider-2"></div>
                                                    <div class="fd-date-time"></div>
                                                    <div class="fd-divider-3"></div>
                                                </div>
                                            </div>
                                            <div class="fd-post">
                                                <div class="fd-place-holder">
                                                    <div class="fd-divider-1"></div>
                                                    <div class="fd-divider-2"></div>
                                                    <div class="fd-date-time"></div>
                                                    <div class="fd-divider-3"></div>
                                                </div>
                                            </div>
                                            <div class="fd-post">
                                                <div class="fd-place-holder">
                                                    <div class="fd-divider-1"></div>
                                                    <div class="fd-divider-2"></div>
                                                    <div class="fd-date-time"></div>
                                                    <div class="fd-divider-3"></div>
                                                </div>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="dashboard-empty-message-div col-12 display-none" data-dashboard-visibility="empty-state-container">
                            <div class="empty-dashboard-image-div">
                                <img class="empty-dashboard-image" src="@dashboardServerResourceUrl/cdn/css/images/dashboard-empty-state.svg" style="margin: 0 auto;/*! width: 100%; */" loading="lazy">
                            </div>
                            <div class="display-none" data-dashboard-visibility="empty-no-category">
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-no-category-no-create">@T["No dashboards have been shared with you."]</span>
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-no-category-can-create">@T["You don�t have any dashboards and no dashboards have been shared with you."]</span>
                            </div>
                            <div class="display-none" data-dashboard-visibility="empty-with-category">
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-with-category-all">@T["No dashboards available to display."]</span>
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-with-category-filtered">@T["No dashboards were found that match your search. Try modifying your search or filters."]</span>
                            </div>
                            <div class="display-none" data-dashboard-visibility="empty-drafts">
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-drafts-default">@T["No drafts available to display."]</span>
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-drafts-search">@T["No drafts were found that match your search. Try modifying your search."]</span>
                            </div>
                            <div class="display-none" data-dashboard-visibility="empty-upload-drafts">
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-upload-default">@T["No upload drafts available to display."]</span>
                                <span class="dashboard-empty-message display-none" data-dashboard-visibility="empty-upload-search">@T["No upload drafts were found that match your search. Try modifying your search."]</span>
                            </div>
                            <div class="create-buttton display-none" data-dashboard-visibility="empty-create-container">
                                <button data-action="create-items" class="primary-button app-btn-primary display-none" data-dashboard-visibility="empty-create-button">@T["Create Dashboard"]</button>
                            </div>
                            <div class="create-buttton display-none" data-dashboard-visibility="empty-upload-container">
                                <button data-action="upload-items" class="primary-button app-btn-primary display-none" data-dashboard-visibility="empty-upload-button">@T["Upload Dashboard"]</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (samePagePreview)
            {
                <div class="dashboard-header-container samepage-preview-header">
                    <div class="col-3 top-nav-sec no-padding">
                        @await Html.PartialAsync("../Shared/_TopMenu")
                    </div>
                    <div class="samepage-dashboard-header-info">
                        <span class="dashboard-page-title"
                              data-dashboard-header-text="page-title"
                              data-title-dashboards="@T["Dashboards"]"
                              data-title-favorites="@T["Favorite Dashboards"]"
                              data-title-public="@T["Public Dashboards"]"
                              data-title-owned="@T["Owned by me"]"
                              data-title-shared="@T["Shared with me"]"
                              data-title-drafts="@T["Draft Dashboards"]"
                              data-title-upload-drafts="@T["Upload Drafts"]"
                              data-title-enterprise-insights="@T["Enterprise Insights"]">@T["Dashboards"]</span>
                        <span class="dashboard-page-count display-none" data-dashboard-visibility="dashboard-count" data-dashboard-text="dashboard-count"></span>
                    </div>
                    <div class="item-searchbox-container col-5" data-hide-on-usage-analytics="true" data-dashboard-layout="samepage-searchbox">
                        <div data-dashboard-visibility="samepage-search-area" class="col-3 no-padding no-margin dashboard-search-area float-end">
                            <span class="su su-inner-close float-end no-margin display-none" data-dashboard-search-icon="clear" data-dashboard-search-clear="true" data-bs-html="true" title="<span class='clear-search-tooltip'>@T["Clear search"]</span>" data-container="body" data-bs-toggle="clear-tooltip" data-bs-placement="bottom"></span>
                            <span class="su su-search float-end no-margin" data-dashboard-search-icon="search" title="@T["Search"]" data-bs-toggle="search-tooltip" data-container="body" data-bs-placement="bottom"></span>
                            <input type="password" name="password" style="display:none;">
                            <input type="text" id="dashboard-search-items" class="float-end no-margin" data-dashboard-search="true" placeholder="@T["Search dashboards"]" />
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Mobile view-->
        <div class="modal fade" id="dashboard-sort-modal" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-body no-padding">
                        <ul class="dashboard-sort-filter-menu no-padding">
                            @* Optional future sort:
                               Recently Added *@
                            <li data-sort-name="ModifiedDate" data-sort-direction="descending">
                                <a class="dashboard-sort-options" href="#">
                                    <i class="su su-tick"></i>
                                    <span class="search-option">@T["Recently Updated"]</span>
                                </a>
                            </li>
                            <li data-sort-name="LastAccessedDate" data-sort-direction="descending">
                                <a class="dashboard-sort-options" href="#">
                                    <i class="su su-tick"></i>
                                    <span class="search-option">@T["Last Accessed - Descending"]</span>
                                </a>
                            </li>
                            <li data-sort-name="Name" data-sort-direction="ascending">
                                <a class="dashboard-sort-options" href="#">
                                    <i class="su su-tick"></i>
                                    <span class="search-option">@T["Dashboard Name (A-Z)"]</span>
                                </a>
                            </li>
                            <li data-sort-name="Name" data-sort-direction="descending">
                                <a class="dashboard-sort-options" href="#">
                                    <i class="su su-tick"></i>
                                    <span class="search-option">@T["Dashboard Name (Z-A)"]</span>
                                </a>
                            </li>
                            @* Optional future sort:
                               Owner Name (A-Z / Z-A) *@
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button type="button" id="dashboard-sort-apply-btn" class="app-button app-primary-button app-btn-primary">@T["Apply"]</button>
                        <button type="button" class="app-button app-secondary-button app-btn-secondary" data-dashboard-sort-close="true" data-bs-dismiss="modal">@T["Close"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        @await Html.PartialAsync("../DefaultPages/DefaultPages", new ViewDataDictionary(ViewData) { { "Permissions", permisions }, { "ItemType", ItemType.Dashboard } })
    }
    
    <div id="tab-security" style="display:none">
        <div id="tab-security-content">@T["Enabling tab-level security will restrict tab visibility to users with the individual dashboard permission when dashboards are added as tabs. By default, all tabs will be visible to the user if the user has access to a multitab dashboard."]</div>
        <span>
            <input type="checkbox" class="material-checkbox" id="tab-security-checkbox">
            <input id="tab-security-checkbox" type="hidden">
            <label for="tab-security-checkbox" class="label-database">@T["Enable tab-level security"]</label>
        </span>
        <div class="bg-warning tab-security-note">
            <Span>@T["All tabs will be visible to the dashboard owner and administrators. Public dashboards added as tabs will also be visible."]</Span>
        </div>
    </div>

    <div id="popup-container" style="display:none" class="no-padding">
        <iframe id="scheduler-popup-iframe" class="datasource-popup-frame"></iframe>
    </div>

    <div id="Download_Item" style="display:none" class="no-padding"></div>

    <div id="make_item_public" class="no-padding float-start" style="display:none"></div>

    <div id="remove_item_public" class="no-padding" style="display:none"></div>

    <div id="make_item_unlist" class="no-padding float-start" style="display:none"></div>
    @if (!isMobile)
    {
        @await Html.PartialAsync("../Items/_AddItems")
        @await Html.PartialAsync("../Items/_SharePermission")
        @await Html.PartialAsync("../Items/_PublishDashboard")
        @await Html.PartialAsync("../Items/_GetExternalSites")
    }
    @await Html.PartialAsync("../Dashboards/_DashboardLogoUploadBox")

    @if (samePagePreview && !isMobile)
    {
        @await Html.PartialAsync("_DashboardIframe")
    }

    @await Html.PartialAsync("../Items/_ItemInfo")

     <script nonce="@Context.Items["ScriptNonce"]" type="text/javascript">
        $(document).ready(function () {
            $('#user-group-search-input_suggestion').addClass("hide-suggesstion");

            if (typeof window.BulkMoveDashboards === "function") {
                var originalBulkMoveDashboards = window.BulkMoveDashboards;
                window.BulkMoveDashboards = function (itemId, itemName, itemDescription) {
                    var bulkMovePopupElement = document.getElementById("BulkMoveDashboardsPopup");
                    var fromCategoryInputElement = document.getElementById("from-category-selected-input");
                    if (!bulkMovePopupElement || !fromCategoryInputElement) {
                        return;
                    }
                    return originalBulkMoveDashboards.call(this, itemId, itemName, itemDescription);
                };
            }

            if (typeof window.AddSubCategory === "function") {
                var originalAddSubCategory = window.AddSubCategory;
                window.AddSubCategory = function (itemId, name, description) {
                    var addSubCategoryPopupElement = document.getElementById("AddSubCategoryPopup");
                    if (!addSubCategoryPopupElement) {
                        return;
                    }
                    return originalAddSubCategory.call(this, itemId, name, description);
                };
            }
        });
    </script>
}
