<div id="publish-info-popup" class="fluent-popup custom-bootstrap-styles custom-server-style" style="display: none"
    data-internal-text="@T["Internal"]"
    data-external-text="@T["External"]"
    data-enabled-text="@T["Enabled"]"
    data-disabled-text="@T["Disabled"]"
    data-allow-dashboard-editing-text="@T["Allow Dashboard Editing"]"
    data-allow-datasource-editing-text="@T["Allow Data Source Editing"]">
    <div class="fluent-popup-header col-12 no-padding">
        <h4 class="popup-title">
            <span class="su su-info"></span>
            <span id="info-dialog-header">@T["Publishing Info"]</span>
            <button id="close-publish-info-dialog" type="button" title="@T["Close"]" data-bs-toggle="tool-tip" data-container="body" class="btn-close popup-close" aria-label="Close">
                <span class="su su-close"></span>
            </button>
        </h4>
    </div>
    <div class="fluent-item-popup-body col-12">
        <span class="item-info-created col-12 no-padding">
            <label class="info-label col-4 no-padding">@T["Name"]:</label><span id="publish-info-item-name" class="col-xs-8 no-padding"></span>
        </span>
        <span class="item-info-created col-12 no-padding">
            <label class="info-label col-4 no-padding">@T["Description"]:</label><span id="publish-info-description" class="col-xs-8 no-padding"></span>
        </span>
        <span id="publish-info-category-row" class="item-info-created col-12 no-padding" style="display:none;">
            <label class="info-label col-4 no-padding">@T["Category Name"]:</label><span id="publish-info-category-name" class="col-xs-8 no-padding"></span>
        </span>
        <span class="item-info-created col-12 no-padding">
            <label class="info-label col-4 no-padding">@T["Published Site"]:</label><span id="publish-info-tenant-name" class="col-xs-8 no-padding"></span>
        </span>
        @if (ServerAppConfig.IsSelfHosted)
        {
            <span class="item-info-created col-12 no-padding">
                <label class="info-label col-4 no-padding">@T["Published Type"]:</label>
                <span id="publish-info-publish-type" class="col-xs-8 no-padding"></span>
            </span>
        }
        <span class="item-info-created col-12 no-padding">
            <label id="publish-info-editing-label" class="info-label col-4 no-padding"></label><span id="publish-info-editing-status" class="col-xs-8 no-padding"></span>
        </span>
        <span class="item-info-created col-12 no-padding">
            <label class="info-label col-4 no-padding">@T["Created By"]:</label><span id="publish-info-created-by" class="col-xs-8 no-padding"></span>
        </span>
        <span class="item-info-created col-12 no-padding">
            <label class="info-label col-4 no-padding">@T["Created Date"]:</label><span id="publish-info-created-date" class="col-xs-8 no-padding"></span>
        </span>
        <span class="item-info-created col-12 no-padding">
            <label class="info-label col-4 no-padding">@T["Last modified by"]:</label><span id="publish-info-last-modified-by" class="col-xs-8 no-padding"></span>
        </span>
        <span class="item-info-created col-12 no-padding">
            <label class="info-label col-4 no-padding">@T["Last modified on"]:</label><span id="publish-info-last-modified-on" class="col-xs-8 no-padding"></span>
        </span>
    </div>
    <div class="fluent-popup-footer col-12">
        <div class="col-12">
            <button id="publish-info-close-button" class="app-button app-secondary-button app-btn-secondary" title="@T["Close"]">@T["Close"]</button>
        </div>
    </div>
</div>
