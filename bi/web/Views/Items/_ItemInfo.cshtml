<div id="item-info-popup"
     class="fluent-popup custom-bootstrap-styles custom-server-style"
     style="display: none"
     data-open-dashboard-text='@T["Open Dashboard"]'
     data-edit-dashboard-text='@T["Edit Dashboard"]'>
    <div class="fluent-popup-header">
        <h4 class="popup-title">
            <span class="su su-info"></span>
            <span id="info-dialog-header">@T["Info"]</span>
            <button id="close-info-dialog" type="button" title='@T["Close"]' data-bs-toggle="tool-tip" data-container="body" class="btn-close popup-close" aria-label="Close">
                <span class="su su-close"></span>
            </button>
        </h4>
    </div>
    <div class="fluent-item-popup-body">
        <p id="item-info-name" class="item-info-name"></p>
        <p id="item-info-description" class="item-info-description" style="white-space:pre-line; display:none;"></p>
        <span id="item-info-id-row" class="item-info-id" style="display:none;">
            <label class="info-label">@T["Item Id"]:</label> <span id="item-info-id"></span>
        </span>
        <span id="item-info-dashboard-id-row" class="item-info-DashboardId" style="display:none;">
            <label class="info-label">@T["Dashboard Id"]:</label> <span id="item-info-dashboard-id"></span>
        </span>
        <span id="item-info-created-by-row" class="item-info-created" style="display:none;">
            <label class="info-label">@T["Created by"]:</label> <span id="item-info-created-by"></span>
        </span>
        <span id="item-info-created-date-row" class="item-info-created" style="display:none;">
            <label class="info-label">@T["Created on"]:</label> <span id="item-info-created-date"></span>
        </span>
        <span id="item-info-modified-by-row" class="item-info-modified" style="display:none;">
            <label class="info-label">@T["Last modified by"]:</label> <span id="item-info-modified-by"></span>
        </span>
        <span id="item-info-modified-date-row" class="item-info-modified" style="display:none;">
            <label class="info-label">@T["Last modified on"]:</label> <span id="item-info-modified-date"></span>
        </span>
        <span id="item-info-category-row" class="item-info-modified" style="display:none;">
            <label class="info-label">@T["Category"]:</label> <span id="item-info-category"></span>
        </span>
    </div>
    <div class="fluent-popup-footer">
        <div id="item-info-dashboard-link-container" class="col-12" style="display:none;">
            <a id="item-info-dashboard-link" href="#" class="link-button app-btn-link" target="_blank" title=""></a>
        </div>
        <div id="item-info-upload-button-container" class="col-12" style="display:none;">
            <button id="item-info-upload-button" type="button" class="link-button app-btn-link">@T["Complete Upload"]</button>
        </div>
        <div id="item-info-close-button-container" class="col-12">
            <button id="item-info-close-button" type="button" class="secondary-button app-btn-secondary" title="">@T["Close"]</button>
        </div>
    </div>
</div>
