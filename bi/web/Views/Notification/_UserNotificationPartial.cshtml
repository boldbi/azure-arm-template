@{
    Layout = null;
    var globalAppSettings = _globalAppSettings;
    var idPAvatarUrl = globalAppSettings.SystemSettings.IDPUrl + "/User/Avatar";
    var displayNameElement = "<span class='notification-display-name'>{{item.DoneByFullName}}</span>";
    var downloadedResourcesUrl = Url.Action("GetPublishedItems", "publish") + "?tab=offline-files";
}

 <script nonce="@Context.Items["ScriptNonce"]" type="text/javascript">
    var userSystemnotificationUrl = "@Url.Action("getnotificationsonrequest", "notification")";
    var viewUrl = "@Url.Action("Dashboards", "Dashboards")";
    var viewWidgetUrl = "@Url.Action("widgets", "widgets")";
    var commentNotificationSource = "@NotificationSource.Comment";
    var downloadedResourcesUrl = "@Url.Action("GetPublishedItems", "publish")" + "?tab=offline-files";
</script>

<div id="user-notification-container" class="col-12 no-padding" style="display:none">
    <div class="notification-header col-12">
        <span class="su su-arrow-back close-user-notification"></span>
        <span class="notification-title">@T["Notifications"]</span>
        <a id="user-notification-settings-link" class="notification-setting-link d-none" href="@(Url.Action("Profilepage", "User").TrimEnd('/') + "?tab=profile-notifications")">@T["SETTINGS"]</a>
    </div>
    <div id="notification-content" class="notification-content-container-partial col-12 no-padding" onscroll="UserNotificationManager.onNotificationScroll()">
        <ul id="notification-list-ul" class="notification-list-ul"></ul>
        <div id="user-notification-loader" class="d-none">
            <div class="loader-blue loader-icon">
                <svg class="circular">
                    <circle class="path" cx="27" cy="27" r="20" fill="none" stroke-width="4" stroke-miterlimit="10"></circle>
                </svg>
            </div>
        </div>
        <div id="no-more-notification-info" class="additional-content col-12 d-none">
            <div><h5>@T["No more notifications found"]</h5></div>
        </div>
        <div id="no-notification-info" class="additional-content d-none">
            <div>
                <img src="@GlobalAppSettings.CdnDomain/static/default-pages/v1/notifications.svg" loading="lazy" />
                <h5>@T["Notification"]</h5>
                <p>@T["When your team starts working on things, notifications will show up here."]</p>
                <a href="@(Url.Action("Profilepage", "User").TrimEnd('/') + "?tab=profile-notifications")">@T["Notification settings"]</a>
            </div>
        </div>
    </div>
</div>

<div id="user-notification-backdrop" style="display: none;"></div>
