<div id="notification-banner" style="display: none;">
    <div class="su su-close float-end" title="@T["close"]"></div>
    <div class="banner-container">
        <div class="announcement-type"></div>
        <h4 class="announcement-title"></h4>
        <div class="announcement-bullets">
            <div id="top-content-container"></div>
            <ul id="bullet-points-container" style="display:none;"></ul>
            <div id="bottom-content-container"></div>
        </div>
        <div class="announcement-date">
            <span id="time-label"></span>
            <div class="announce-bottom-date" id="display-time"></div>
        </div>
        <a id="notification-button" target="_blank" style="display:none;">
            <div class="button-content"></div>
        </a>
    </div>
</div>