<div id="user-activity-log" style="visibility:hidden"></div>

<div id="activitylog-info-popup">
    <div class="fluent-item-popup-body" id="dialog-content">
        <span class="col-12 float-end activity-log-summary">
            <label class="activity-log-label">@T["Summary"]</label>
            <span id="activitylog-summary-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-date">
            <label class="activity-log-label">@T["Timestamp"]</label>
            <span id="activitylog-date-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-username">
            <label class="activity-log-label">@T["Performed By"]</label>
            <span id="activitylog-performed-by-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-email">
            <label class="activity-log-label">@T["User Email"]</label>
            <span id="activitylog-user-email-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-site">
            <label class="activity-log-label">@T["Site"]</label>
            <span id="activitylog-site-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-ipaddress">
            <label class="activity-log-label">@T["IP Address"]</label>
            <span id="activitylog-ip-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-event-type">
            <label class="activity-log-label">@T["Event Category"]</label>
            <span id="activitylog-event-category-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-event-category">
            <label class="activity-log-label">@T["Event Type"]</label>
            <span id="activitylog-event-type-value" class="activity-log-detail">-</span>
        </span>
        <span id="activitylog-source-row" class="col-12 float-end activity-log-source" style="display:none">
            <label class="activity-log-label">@T["Source"]</label>
            <span id="activitylog-source-value" class="activity-log-detail">-</span>
        </span>
        <span class="col-12 float-end activity-log-user-agent">
            <label class="activity-log-label">@T["User Agent"]</label>
            <span id="activitylog-user-agent-value" class="activity-log-detail">-</span>
        </span>
        <div id="activitylog-change-summary-section" class="col-12 float-end" style="display:none">
            <span class="col-12 float-end horizontal-line"></span>
            <label class="col-12 changes-logs-label">@T["Change Summary"]</label>
            <div id="activitylog-change-summary-body"
                 data-updated-field-label="@T["Updated Field"]"
                 data-changes-label="@T["Changes"]"
                 data-old-value-label="@T["Old Value"]"
                 data-new-value-label="@T["New Value"]"></div>
        </div>
    </div>
</div>
