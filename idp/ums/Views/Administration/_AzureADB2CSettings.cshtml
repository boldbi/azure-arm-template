@{
    var appBranding = GlobalAppSettings.Branding;
    var b2c = ViewBag.AzureADB2CSettings != null ? ViewBag.AzureADB2CSettings.AzureADB2CSettings : null;
    var isB2CEnabled = ViewBag.AzureADB2CSettings != null && ViewBag.AzureADB2CSettings.IsEnabled;
    var isB2CSloEnabled = b2c != null && b2c.IsSloEnabled;
    var providerName = b2c != null && b2c.AzureB2CProviderName != null ? b2c.AzureB2CProviderName : string.Empty;
    var appId = b2c != null && b2c.ApplicationId != null ? b2c.ApplicationId : string.Empty;
    var tenantName = b2c != null && b2c.TenantName != null ? b2c.TenantName : string.Empty;
    var tenantId = b2c != null && b2c.TenantId != null ? b2c.TenantId : string.Empty;
    var signInPolicy = b2c != null && b2c.SigninPolicy != null ? b2c.SigninPolicy : string.Empty;
    var logoUrl = ViewBag.AzureADB2CSettings != null && ViewBag.AzureADB2CSettings.LogoUrl != null ? ViewBag.AzureADB2CSettings.LogoUrl : string.Empty;
    var logoStyle = string.Empty;
    if (!string.IsNullOrWhiteSpace(logoUrl))
    {
        logoStyle = logoUrl.TrimStart().StartsWith("url(", StringComparison.OrdinalIgnoreCase) ? logoUrl : $"url('{logoUrl}')";
    }
}
<div role="tabpanel" class="tab-pane col-12 float-start no-padding" id="azure-ad-b2c-settings-tab">
    <div id="azure-ad-b2c-page-body" class="col-lg-12 col-md-12 col-sm-12 float-start admin-page-body">
        <form id="saml-b2c-setting" name="ssoSettingsb2cForm" class="saml-form auth-settings-form col-lg-12 col-md-12 col-sm-12 float-start no-padding" method="post" enctype="multipart/form-data" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="azureADB2CAuthenticationProvider" value="@ViewBag.AzureADB2CSettings.AuthProvider">
            <input type="hidden" name="azureB2CLogo" value="@ViewBag.AzureADB2CSettings.AzureADB2CSettings.Logo">
            <div class="col-12 float-start separator-margin">
                <div class="col-12 float-start no-padding">
                    <div class="material-switch inline-align">
                        <input type="checkbox" id="enable-sso-b2c" @(isB2CEnabled ? "checked" : string.Empty) />
                        <label for="enable-sso-b2c" class="label-primary"></label>
                    </div>
                    <div class="app-textbox-label inline-align">
                        @T["Enable Azure AD B2C"]
                    </div>
                </div>
                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Organization Name"]</label>
                    </div>
                    <div id="azureb2c-provider-name-container">
                        <input type="text" class="form-control no-margin" value="@providerName" maxlength="20" name="AzureB2CProviderName" placeholder="@T["Organization Name"]" id="azure-b2c-provider-name" @(isB2CEnabled ? string.Empty : "disabled") />
                        <span id="azureb2c-provider-name-maxlength-validation" class="validation-message top-padding display-none">@T["Organization name is too long. Must be no more than 20 characters."]</span>
                        <span id="azureb2c-provider-name-required-validation" class="validation-message top-padding display-none">@T["Please enter your organization name."]</span>
                    </div>
                    <div class="info-message no-padding">@T["Name of the organization to be displayed in the login page."]</div>
                </div>
                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Organization Logo"]</label>
                    </div>
                    <div class="col-12 float-start no-padding logo-container">
                        <div id="azure-b2c-image-upload-box" class="auth-image-upload-box">
                            <div class="js-image-preview" style="background-image:@logoStyle"></div>
                            <div class="upload-options">
                                <label>
                                    <span>@T["Change logo"]</span>
                                    <input type="file" class="image-upload" accept="image/png,image/jpeg,image/svg+xml" name="azureB2CLogoUrl" @(isB2CEnabled ? string.Empty : "disabled") />
                                </label>
                            </div>
                        </div>
                        <span id="azureb2c-logo-validation" class="validation-message top-padding display-none"></span>
                    </div>
                    <div class="info-message no-padding">@T["Logo of the organization to be displayed in the login page."]</div>
                </div>
                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Application Id"]</label>
                    </div>
                    <div id="azureb2c-application-id-container">
                        <input type="text" class="form-control no-margin" value="@appId" name="ApplicationIdB2C" placeholder="@T["Application Id"]" id="application-id-b2c" @(isB2CEnabled ? string.Empty : "disabled") />
                        <span id="azureb2c-application-id-required-validation" class="validation-message top-padding display-none">@T["Please enter the application id."]</span>
                    </div>
                    @if (appBranding == AppBranding.Bold.Identifier)
                    {
                        <div class="info-message no-padding">
                            @T[$"A unique identifier of the {AppBranding.Bold.ProductName} web app created in Azure AD B2C."]
                        </div>
                    }
                    else
                    {
                        <div class="info-message no-padding">
                            @T[$"A unique identifier of the {AppBranding.BoldReports.ProductName} web app created in Azure AD B2C."]
                        </div>
                    }
                </div>
                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Tenant Name"]</label>
                    </div>
                    <div id="azureb2c-tenant-name-container">
                        <input type="text" class="form-control no-margin" value="@tenantName" name="TenantNameB2C" placeholder="@T["Tenant Name"]" id="tenant-name-b2c" @(isB2CEnabled ? string.Empty : "disabled") />
                        <span id="azureb2c-tenant-name-required-validation" class="validation-message top-padding display-none">@T["Please enter tenant name."]</span>
                        <span id="azureb2c-tenant-name-pattern-validation" class="validation-message top-padding display-none">@T["Please enter valid tenant name."]</span>
                    </div>
                    <div class="info-message no-padding">@T["A dedicated instance of the Azure AD B2C service."]</div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Tenant ID"]</label>
                    </div>
                    <div id="azureb2c-tenant-id-container">
                        <input type="text" class="form-control no-margin" value="@tenantId" name="TenantIdB2C" placeholder="@T["Tenant Id"]" id="tenant-id-b2c" @(isB2CEnabled ? string.Empty : "disabled") />
                        <span id="azureb2c-tenant-id-required-validation" class="validation-message top-padding display-none">@T["Please enter tenant id."]</span>
                    </div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Client Secret"]</label>
                        <div class="col-md-12 float-start no-padding" style="position:relative">
                            <input type="password" class="form-control no-margin" name="ClientSecretB2C" placeholder="@T["Client Secret"]" id="client-secret-b2c" @(isB2CEnabled ? string.Empty : "disabled") />
                            <span id="azureb2c-client-secret-required-validation" class="validation-message top-padding display-none">@T["Please enter client secret."]</span>
                            <span class="show-hide-password su su-show" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to view"]"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Sign in Policy"]</label>
                    </div>
                    <div id="azureb2c-policy-container">
                        <input type="text" class="form-control no-margin" value="@signInPolicy" name="PolicyB2C" placeholder="@T["Sign in Policy"]" id="policy-b2c" @(isB2CEnabled ? string.Empty : "disabled") />
                        <span id="azureb2c-policy-required-validation" class="validation-message top-padding display-none">@T["Please enter the policy name."]</span>
                    </div>
                    <div class="info-message no-padding">@T["The name of the Sign in/Sign up user flow created in Azure AD B2C."]</div>
                </div>
                <div class="col-12 float-start no-padding input-field-margin">
                    <div class="material-switch inline-align">
                        <input type="checkbox" id="enable-slo-b2c" @(isB2CSloEnabled ? "checked" : string.Empty) @(isB2CEnabled ? string.Empty : "disabled") />
                        <label for="enable-slo-b2c" class="label-primary"></label>
                    </div>
                    <div class="app-textbox-label inline-align">
                        @T["Enable Single Logout"]
                    </div>
                    <div class="info-message no-padding">
                        @T["The single logout (SLO) option allows users to log out of both the application and Azure AD B2C."]
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

