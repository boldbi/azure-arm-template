@{
    var openIdSettings = ViewBag.OpenIDSettings != null ? ViewBag.OpenIDSettings.OIDCAuthSettings : null;
    var isOpenIdEnabled = ViewBag.OpenIDSettings != null && ViewBag.OpenIDSettings.IsEnabled;
    var providerName = openIdSettings != null && openIdSettings.ProviderName != null ? openIdSettings.ProviderName : string.Empty;
    var authority = openIdSettings != null && openIdSettings.Authority != null ? openIdSettings.Authority : string.Empty;
    var clientId = openIdSettings != null && openIdSettings.ClientId != null ? openIdSettings.ClientId : string.Empty;
    var identifier = openIdSettings != null && openIdSettings.Identifier != null ? openIdSettings.Identifier : string.Empty;
    var responseType = openIdSettings != null && openIdSettings.ResponseType != null ? openIdSettings.ResponseType : "id_token";
    var logoutUrl = openIdSettings != null && openIdSettings.LogoutUrl != null ? openIdSettings.LogoutUrl : string.Empty;
    var enableTokenStorage = openIdSettings != null && openIdSettings.EnableTokenStorage;
    var usePkce = openIdSettings != null && openIdSettings.UsePkce;
    var logoUrl = ViewBag.OpenIDSettings != null && ViewBag.OpenIDSettings.LogoUrl != null ? ViewBag.OpenIDSettings.LogoUrl : string.Empty;
    var logoStyle = string.Empty;
    if (!string.IsNullOrWhiteSpace(logoUrl))
    {
        logoStyle = logoUrl.TrimStart().StartsWith("url(", StringComparison.OrdinalIgnoreCase) ? logoUrl : $"url('{logoUrl}')";
    }
    var canCreateAccount = openIdSettings != null && openIdSettings.CanCreateAccount;
}
<div role="tabpanel" class="tab-pane col-12 float-start no-padding" id="openid-settings-tab">
    <div id="openid-page-body" class="col-lg-12 col-md-12 col-sm-12 float-start admin-page-body">
        <form id="openid-setting" name="openidSettingsForm" class="auth-settings-form col-lg-12 col-md-12 col-sm-12 float-start no-padding" method="post" enctype="multipart/form-data" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="openidAuthenticationProvider" value="@ViewBag.OpenIDSettings.AuthProvider">
            <input type="hidden" name="openidLogo" value="@ViewBag.OpenIDSettings.OIDCAuthSettings.Logo">
            <div class="col-12 float-start separator-margin">
                <div class="col-12 float-start no-padding">
                    <div class="material-switch inline-align">
                        <input type="checkbox" id="openidIsEnabled" @(isOpenIdEnabled ? "checked" : string.Empty) />
                        <label for="openidIsEnabled" class="label-primary"></label>
                    </div>
                    <div class="app-textbox-label inline-align">
                        @T["Enable OpenID Connect"]
                    </div>
                </div>
                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Provider Name"]</label>
                    </div>
                    <div id="openid-provider-name-container">
                        <input type="text" class="form-control no-margin" value="@providerName" maxlength="20" name="openidProviderName" placeholder="@T["Provider Name"]" id="openid-provider-name" @(isOpenIdEnabled ? string.Empty : "disabled") />
                        <span id="openid-provider-name-maxlength-validation" class="validation-message top-padding display-none">@T["Provider name is too long. Must be no more than 20 characters."]</span>
                        <span id="openid-provider-name-required-validation" class="validation-message top-padding display-none">@T["Please enter the OpenID provider name."]</span>
                    </div>
                    <div class="info-message no-padding">@T["Name of the authentication provider to be displayed in the login page."]</div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Provider Logo"]</label>
                    </div>
                    <div class="col-12 float-start no-padding logo-container">
                        <div id="openid-image-upload-box" class="auth-image-upload-box">
                            <div class="js-image-preview" style="background-image:@logoStyle"></div>
                            <div class="upload-options">
                                <label>
                                    <span>@T["Change logo"]</span>
                                    <input type="file" class="image-upload" accept="image/png,image/jpeg,image/svg+xml" name="openidLogoUrl" @(isOpenIdEnabled ? string.Empty : "disabled") />
                                </label>
                            </div>
                        </div>
                        <span id="openid-logo-validation" class="validation-message top-padding display-none"></span>
                    </div>
                    <div class="info-message no-padding">@T["Logo of the authentication provider to be displayed in the login page."]</div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Authority"]</label>
                    </div>
                    <div id="openid-authority-container">
                        <input type="text" class="form-control no-margin" value="@authority" name="openidAuthority" placeholder="@T["Authority"]" id="openid-authority" @(isOpenIdEnabled ? string.Empty : "disabled") />
                        <span id="openid-authority-required-validation" class="validation-message display-none">@T["Please enter the Authority URL."]</span>
                        <span id="openid-authority-pattern-validation" class="validation-message display-none">@T["Please enter a valid Authority URL."]</span>
                    </div>
                    <div class="info-message no-padding">@T["Endpoint to authenticate the user and grant access to the protected resource. It returns the claims about the authenticated user."]</div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Client Id"]</label>
                    </div>
                    <div id="openid-client-id-container">
                        <input type="text" class="form-control no-margin" value="@clientId" name="openidClientId" placeholder="@T["Client Id"]" id="openid-client-id" @(isOpenIdEnabled ? string.Empty : "disabled") />
                        <span id="openid-client-id-required-validation" class="validation-message display-none">@T["Please enter the Client ID."]</span>
                    </div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Client Secret"]</label>
                        <div class="col-md-12 float-start no-padding" id="openid-client-secret-container" style="position:relative">
                            <input type="password" class="form-control no-margin" name="openidClientSecret" placeholder="@T["Client Secret"]" id="openid-client-secret" @(isOpenIdEnabled ? string.Empty : "disabled") />
                            <span id="openid-client-secret-required-validation" class="validation-message display-none">@T["Please enter the client secret."]</span>
                            <span class="show-hide-password su su-show" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to view"]"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Identifier"]</label>
                    </div>
                    <div id="openid-identifier-container">
                        <input type="text" class="form-control no-margin" value="@identifier" name="openidIdentifier" placeholder="@T["Identifier"]" id="openid-identifier" @(isOpenIdEnabled ? string.Empty : "disabled") />
                        <span id="openid-identifier-required-validation" class="validation-message display-none">@T["Please enter the Identifier."]</span>
                    </div>
                    <div class="info-message no-padding">@T["These claims are normally represented by a JSON object that contains a collection of name and value pairs for each claim. Provide the JSON key to identify the unique identity (email) of the user."]</div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Response Type"]</label>
                    </div>
                    <div>
                        <select id="response-type-dropdown" class="no-padding admin-settings-drop-down" @(isOpenIdEnabled ? string.Empty : "disabled")>
                            <option class="no-margin-dropdown-ul" value="id_token" selected="@(responseType == "id_token")">@T["id_token"]</option>
                            <option class="no-margin-dropdown-ul" value="code" selected="@(responseType == "code")">@T["code"]</option>
                        </select>
                    </div>
                    <div class="info-message no-padding">@T["Select the response type for OpenID authentication. The default type is id_token."] </div>
                </div>

                <div class="col-md-12 float-start no-padding switch-margin">
                    <div class="material-switch inline-align">
                        <input type="checkbox" id="enable-openid-token-storage" @(enableTokenStorage ? "checked" : string.Empty) @(isOpenIdEnabled ? string.Empty : "disabled") />
                        <label for="enable-openid-token-storage" class="label-primary"></label>
                    </div>
                    <div class="app-textbox-label inline-align">
                        @T["Enable Token Storage"]
                    </div>
                    <div class="info-message no-padding">@T["When enabled, access and refresh tokens returned by the OpenID Connect provider are stored securely on the server (encrypted at rest and access‑restricted). Tokens are used exclusively by server‑side components for authentication continuity and refresh operations and are never exposed to client‑side code or data source connectors."]</div>
                </div>

                <div class="col-md-12 float-start no-padding switch-margin">
                    <div class="material-switch inline-align">
                        <input type="checkbox" id="enable-openid-pkce" @(usePkce ? "checked" : string.Empty) @((isOpenIdEnabled && enableTokenStorage) ? string.Empty : "disabled") />
                        <label for="enable-openid-pkce" class="label-primary"></label>
                    </div>
                    <div class="app-textbox-label inline-align">
                        @T["Use PKCE"]
                    </div>
                    <div class="info-message no-padding">@T["Enables Proof Key for Code Exchange (PKCE) to protect the authorization code flow from interception attacks. This option is available only when Token Storage is enabled and Keycloak is used as the OpenID Connect provider. Strongly recommended for enhanced security, especially when tokens are stored on the server."]</div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Logout Endpoint"]</label>
                    </div>
                    <div id="openid-logout-endpoint-container">
                        <input type="text" class="form-control no-margin" value="@logoutUrl" name="openidLogoutUrl" placeholder="@T["Logout Endpoint (Optional)"]" id="openid-logout-endpoint" @(isOpenIdEnabled ? string.Empty : "disabled") />
                        <span id="openid-logout-endpoint-pattern-validation" class="validation-message display-none">@T["Please enter a valid logout endpoint."]</span>
                    </div>
                    <div class="info-message no-padding">@T["We support logout endpoints that have static request parameters."]</div>
                </div>

                <div class="col-md-12 float-start no-padding input-field-margin">
                    <div class="col-md-12 float-start no-padding">
                        <label class="app-textbox-label">@T["Redirect URI"]</label>
                        <div class="col-md-12 no-padding">
                            <input id="openid-callback-link" value="@(GlobalAppSettings.SystemSettings.BaseUrl + AuthenticationConfig.OidcCallabckUrl)" class="form-control no-margin" readonly />
                            <div class="form-control su su-copy text focus" id="openid-callback-link-copy" readonly="" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to copy"]"></div>
                        </div>
                    </div>
                    <div class="info-message col-md-12 no-padding">@T["This URI is used to receive the response from the authorization server. When setting up your OpenID Connect application, it's essential to register the redirect URI using only lowercase characters."]</div>
                </div>
                @if (!GlobalAppSettings.SystemSettings.HideMobileAppRedirectURI)
                {
                    <div class="col-md-12 float-start no-padding input-field-margin">
                        <div class="col-md-12 float-start no-padding">
                            <label class="app-textbox-label">@T["Mobile App Redirect URI"]</label>
                            <div>
                                <input id="openid-mobile-callback-link" value="com.boldbi.dashboard://auth" class="form-control no-margin" readonly />
                                <div class="form-control su su-copy text focus" id="openid-mobile-callback-link-copy" readonly="" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to copy"]"></div>
                            </div>
                        </div>
                    </div>
                }
                <div class="col-md-12 float-start no-padding switch-margin">
                    <div class="material-switch inline-align">
                        <input type="checkbox" id="enable-openid-account-creation" @(canCreateAccount ? "checked" : string.Empty) @(isOpenIdEnabled ? string.Empty : "disabled") />
                        <label for="enable-openid-account-creation" class="label-primary"></label>
                    </div>
                    <div class="app-textbox-label inline-align">
                        @T["Enable User Account Creation"]
                    </div>
                    <div class="info-message no-padding">@T["Create a new user account during login if one does not already exist."]</div>
                </div>
            </div>
            <div class="col-12 float-start separator-margin">
                <div id="openid-group-import" class="group-import">
                    @await Html.PartialAsync("_AuthenticationGroupImportSettings", (AuthGroupImportSettings)ViewBag.OpenIDSettings.OIDCAuthSettings.GroupImportSettings, new ViewDataDictionary(ViewData) { { "AuthType", AuthType.OIDC } })
                </div>
            </div>
        </form>
    </div>
</div>


