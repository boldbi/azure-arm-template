@{
    var enableSigningKeyOptions = !string.IsNullOrEmpty(ViewBag.JwtSettings.JwtSettings.SigningKey);
    var jwtSettings = ViewBag.JwtSettings != null ? ViewBag.JwtSettings.JwtSettings : null;
    var isJwtEnabled = ViewBag.JwtSettings != null && ViewBag.JwtSettings.IsEnabled;
    var providerName = jwtSettings != null && jwtSettings.Name != null ? jwtSettings.Name : string.Empty;
    var loginUrl = jwtSettings != null && jwtSettings.LoginUrl != null ? jwtSettings.LoginUrl : string.Empty;
    var logoutUrl = jwtSettings != null && jwtSettings.LogOutUrl != null ? jwtSettings.LogOutUrl : string.Empty;
    var logoUrl = ViewBag.JwtSettings != null && ViewBag.JwtSettings.LogoUrl != null ? ViewBag.JwtSettings.LogoUrl : string.Empty;
    var logoStyle = string.Empty;
    if (!string.IsNullOrWhiteSpace(logoUrl))
    {
        logoStyle = logoUrl.TrimStart().StartsWith("url(", StringComparison.OrdinalIgnoreCase) ? logoUrl : $"url('{logoUrl}')";
    }
    var isEncryptionEnabled = ViewBag.IsEncryptionEnabled != null && ViewBag.IsEncryptionEnabled;
}
<div role="tabpanel" class="tab-pane col-12 float-start no-padding" id="jwt-settings-tab">
    <div id="jwt-page-body" class="col-lg-12 col-md-12 col-sm-12 float-start admin-page-body">
        <form id="jwt-setting" name="jwtSettingsForm" class="auth-settings-form col-lg-12 col-md-12 col-sm-12 float-start no-padding" method="post" enctype="multipart/form-data" autocomplete="off">
            @Html.AntiForgeryToken()
            <input type="hidden" name="jwtAuthenticationProvider" value="@ViewBag.JwtSettings.AuthProvider">
            <input type="hidden" name="jwtLogo" value="">
            <div class="col-12 float-start no-padding">
                <div class="material-switch inline-align">
                    <input type="checkbox" id="enable-jwt" @(isJwtEnabled ? "checked" : string.Empty) />
                    <label for="enable-jwt" class="label-primary"></label>
                </div>
                <div class="app-textbox-label inline-align">
                    @T["Enable JWT"]
                </div>
            </div>

            <div class="col-md-12 float-start no-padding input-field-margin">
                <div class="col-md-12 float-start no-padding">
                    <label class="app-textbox-label">@T["Name"]<span class="mandatory">*</span></label>
                </div>
                <div id="jwt-provider-name-container">
                    <input type="text" class="form-control no-margin" value="@providerName" maxlength="20" name="jwtName" placeholder="@T["Name"]" id="jwt-provider-name" @(isJwtEnabled ? string.Empty : "disabled") />
                    <span id="jwt-provider-name-maxlength-validation" class="validation-message top-padding display-none">@T["Provider name is too long. Must be no more than 20 characters."]</span>
                    <span id="jwt-provider-name-required-validation" class="validation-message top-padding display-none">@T["Please enter the name."]</span>
                </div>
            </div>

            <div class="col-md-12 float-start no-padding input-field-margin">
                <div class="col-md-12 float-start no-padding">
                    <label class="app-textbox-label">@T["Provider Logo"]<span class="mandatory">*</span></label>
                </div>
                <div class="col-12 float-start no-padding logo-container">
                    <div id="jwt-image-upload-box" class="auth-image-upload-box">
                        <div class="js-image-preview" style="background-image:@logoStyle"></div>
                        <div class="upload-options">
                            <label>
                                <span>@T["Change logo"]</span>
                                <input type="file" class="image-upload" accept="image/png,image/jpeg,image/svg+xml" name="jwtLogoUrl" @(isJwtEnabled ? string.Empty : "disabled") />
                            </label>
                        </div>
                    </div>
                    <span id="jwt-logo-validation" class="validation-message top-padding display-none"></span>
                </div>
            </div>

            <div class="col-md-12 float-start no-padding input-field-margin">
                <div class="col-md-12 float-start no-padding">
                    <label class="app-textbox-label">@T["Remote Login URL"]<span class="mandatory">*</span></label>
                </div>
                <div id="jwt-login-url-container">
                    <input type="text" class="form-control no-margin" value="@loginUrl" name="jwtLoginUrl" placeholder="@T["Remote Login URL"]" id="jwt-authority" @(isJwtEnabled ? string.Empty : "disabled") />
                    <span id="jwt-login-url-required-validation" class="validation-message top-padding display-none">@T["Please enter the login url."]</span>
                    <span id="jwt-login-url-pattern-validation" class="validation-message top-padding display-none">@T["Please enter a valid login url."]</span>
                </div>
            </div>

            <div class="col-md-12 float-start no-padding input-field-margin">
                <div class="col-md-12 float-start no-padding">
                    <label class="app-textbox-label">@T["Remote Logout URL"]</label>
                </div>
                <div id="jwt-logout-url-container">
                    <input type="text" class="form-control no-margin" value="@logoutUrl" name="jwtLogOutUrl" placeholder="@T["Remote Logout URL(Optional)"]" id="jwt-client-id" @(isJwtEnabled ? string.Empty : "disabled") />
                    <span id="jwt-logout-url-pattern-validation" class="validation-message top-padding display-none">@T["Please enter a valid logout url."]</span>
                </div>
            </div>

            <div class="col-md-12 float-start no-padding input-field-margin margin-bottom">
                <div class="col-md-12 float-start no-padding">
                    <label class="app-textbox-label">@T["Signing Key"]</label>
                </div>
                <div>
                    <input type="password" id="jwt-signing-key" readonly="" class="form-control no-margin signing-key-values @(!enableSigningKeyOptions ? "signing-key-width" : string.Empty)" name="jwtSigningKey" placeholder="&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;" value="@ViewBag.JwtSettings.JwtSettings.SigningKey" />

                    <div class="su su-show form-control show-hide-password copy-signing-key-values @(enableSigningKeyOptions ? string.Empty : "display-none")" id="show-signing-key" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to view"]"></div>
                    <div class="su su-copy form-control copy-signing-key-values @(enableSigningKeyOptions ? string.Empty : "display-none")" id="copy-signing-key" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to copy"]"></div>
                    <div class="su su-sync form-control text focus copy-signing-key-values @(enableSigningKeyOptions ? string.Empty : "display-none")" id="generate-signing-key" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to Regenerate"]" data-bs-trigger="hover"></div>
                </div>
            </div>
            <div class="col-md-12 float-start no-padding input-field-margin margin-bottom jwt-encryption-field">
                <div class="material-switch inline-align col-12">
                    <input type="checkbox" id="enable-jwt-encryption" @(isEncryptionEnabled ? "checked" : string.Empty) @(isJwtEnabled ? string.Empty : "disabled") />
                    <label for="enable-jwt-encryption" class="label-primary"></label>
                </div>
                <div class="app-textbox-label inline-align activation">
                    @T["Enable Encryption"]
                </div>
                <div class="info-message no-padding">@T["Enable encryption to enhance the security of JWT tokens. When enabled, tokens need to be encrypted using a public key before transmission."]</div>
                <div class="col-12 no-padding">
                    <input type="password" id="jwt-encryption-key" readonly="" class="form-control txt-holder validation-padding signing-key-values @(!isEncryptionEnabled ? "encryption-key-width" : string.Empty)" name="jwtEncryptionKey" placeholder="&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;" value="@ViewBag.PublicKey" @((isJwtEnabled && isEncryptionEnabled) ? string.Empty : "disabled") />
                    <div class="su su-eye form-control show-hide-password copy-signing-key-values @(isEncryptionEnabled ? string.Empty : "display-none")" id="show-encryption-key" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to view"]"></div>
                    <div class="su su-copy form-control copy-signing-key-values @(isEncryptionEnabled ? string.Empty : "display-none")" id="copy-encryption-key" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to copy"]"></div>
                    <div class="su su-sync form-control text focus copy-signing-key-values @(isEncryptionEnabled ? string.Empty : "display-none")" id="generate-encryption-key" data-bs-toggle="tooltip" data-bs-original-title="@T["Click to Regenerate"]" data-bs-trigger="hover"></div>
                </div>
            </div>
        </form>
    </div>
</div>

