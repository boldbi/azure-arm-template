@using Syncfusion.Server.Base;
@using Syncfusion.Server.Base.DataClasses;
@using Microsoft.AspNetCore.Http;
@using System.Collections.Generic
@{
    Layout = null;
    var imageHelper = new ImageHelper(Context);
    var rawErrorStackTrace = Convert.ToString(ViewBag.Errorstacktrace);
    var errorstacktrace = string.IsNullOrEmpty(rawErrorStackTrace) ? string.Empty : GlobalAppSettings.ReplaceErrorStackTrace(rawErrorStackTrace);
    var isAdmin = Context.Session.GetString("IsAdmin") != null ? Convert.ToBoolean(Context.Session.GetString("IsAdmin").ToString()) : false;
    var isUpgradeExecutionError = string.Equals(ViewBag.ErrorType as string, "upgrade_execution", StringComparison.OrdinalIgnoreCase);
    var upgradeErrorDetails = ViewBag.UpgradeErrorDetails as IEnumerable<KeyValuePair<string, string>>;
    var upgradeAccessDecision = ViewBag.UpgradeSiteAccessDecision as UpgradeSiteAccessDecision;
    var continueAccessUrl = GlobalAppSettings.SystemSettings.BaseUrl + (GlobalAppSettings.SystemSettings.BaseUrl.Contains("?") ? "&" : "?") + "continue-upgrade-access=true";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@T["Internal Server Error"] - @GlobalAppSettings.SystemSettings.OrganizationName</title>
    @await Html.PartialAsync("../Shared/_Favicon")
    @await Html.PartialAsync("../Shared/_FontReference")
    @await Html.PartialAsync("../Shared/_ThemeReference")
    <link rel="stylesheet" href="~/bundles/css/error-page.css" integrity="@IntegrityTagHelper.GetIntegrity("bundles/css/error-page.css")" crossorigin="anonymous" asp-append-version="true" />
    <script nonce="@Context.Items["ScriptNonce"]" src="~/bundles/js/error.js" integrity="@IntegrityTagHelper.GetIntegrity("bundles/js/error.js")" crossorigin="anonymous" asp-append-version="true"></script>
    <script nonce="@Context.Items["ScriptNonce"]">
            var defaultErrorImageSrc = "@Url.Content(CloudAppConfig.FallbackLoginLogoUrl)";
            document.addEventListener("DOMContentLoaded", function () {
                var logoimage = document.getElementById("page-not-found-image-five-hundred");
                if (logoimage) {
                    logoimage.onerror = function () {
                        this.onerror = null;
                        this.src = defaultErrorImageSrc;
                    };
                }
            });
    </script>
</head>
<body class="error-full-content">
    @await Html.PartialAsync("~/Views/Shared/_LocalizationContent.cshtml")
    <div class="error-page-outer">
        <div class="error-page-content">
            <div class="error-inside">
                <div class="error-image-center-1">
                    <img id="page-not-found-image-five-hundred" src="@Url.Content($"{CloudAppConfig.TenantManagementUrl(Context).TrimEnd('/')}/logos?type=login")" class="error-image-1">
                </div>
                <div class="error-image-center-2">
                    <img src="@imageHelper.InternalServerErrorImage()" class="error-image-2">
                </div>
                <div class="error-type">@T["Internal Server Error (500)"]</div>
                <div class="error-text">
                    @T["Sorry! The server has encountered an internal error and was unable to complete your request."]
                </div>
                @if (ViewBag.ErrorMessage != null)
                {
                    @if (GlobalAppSettings.SystemSettings.ShowStackTrace || isAdmin)
                    {
                        <div id="deploy-error-container">
                            @if (isUpgradeExecutionError && upgradeErrorDetails != null)
                            {
                                <div class="upgrade-error-box" style="width: 500px; height: 120px; overflow: auto; border: 1px solid var(--grey-400); box-sizing: border-box; border-radius: 4px; padding: 12px 36px 12px 14px; text-align: left; background: var(--surface); color: var(--primary-text-normal-color); font-size: 12px; line-height: 20px;">
                                    @foreach (var detail in upgradeErrorDetails)
                                    {
                                        <div>
                                            <strong>@detail.Key:</strong>
                                            <span>@detail.Value</span>
                                        </div>
                                    }
                                </div>
                                <textarea type="text" id="deploy-error-box" disabled style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0;">@ViewBag.ErrorMessage</textarea>
                            }
                            else
                            {
                                <textarea type="text" id="deploy-error-box" disabled>@T["ErrorMessage"]:@ViewBag.ErrorMessage
@T["ErrorStacktrace"]:@errorstacktrace</textarea>
                            }
                            <span class="su su-copy text focus" id="deploy-error-copy" data-bs-toggle="tooltip" title="@T["Click to copy"]"></span>
                        </div>
                    }
                    else
                    {
                        <div id="deploy-error-container">
                            @if (isUpgradeExecutionError && upgradeErrorDetails != null)
                            {
                                <div class="upgrade-error-box" style="width: 500px; height: 120px; overflow: auto; border: 1px solid var(--grey-400); box-sizing: border-box; border-radius: 4px; padding: 12px 36px 12px 14px; text-align: left; background: var(--surface); color: var(--primary-text-normal-color); font-size: 12px; line-height: 20px;">
                                    @foreach (var detail in upgradeErrorDetails)
                                    {
                                        <div>
                                            <strong>@detail.Key:</strong>
                                            <span>@detail.Value</span>
                                        </div>
                                    }
                                </div>
                                <textarea type="text" id="deploy-error-box" disabled style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0;">@ViewBag.ErrorMessage</textarea>
                            }
                            else
                            {
                                <textarea type="text" id="deploy-error-box" disabled>@T["ErrorMessage"]:@ViewBag.ErrorMessage</textarea>
                            }
                            <span class="su su-copy text focus" id="deploy-error-copy" data-bs-toggle="tooltip" title="@T["Click to copy"]"></span>
                        </div>
                    }

                    @if (isUpgradeExecutionError)
                    {
                        <div class="take-me-back-to-home-page">
                            @if (upgradeAccessDecision?.CanAccessSite == true)
                            {
                                @Html.Raw(string.Format(T["{0}Go to profile page{1} or {2}Create a support ticket{3} with application logs by referring to this {4}link{5}."].Value,
                                $"<span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='" + continueAccessUrl + "'>",
                                "</a></span>",
                                $"</span><span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='https://support.{GlobalAppSettings.BrandingDomain}/create' target='_blank'>",
                                "</a></span>",
                                $"</span><span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='{await HelpSiteManager.GetHelpSiteUrl(HelpSiteUrlNames.ErrorAndDebugLogs)}' target='_blank'>",
                                "</a></span>"))
                            }
                            else
                            {
                                <span>@T["Site access is temporarily blocked because the database upgrade could not be safely completed. Review the application logs and resolve the upgrade issue before retrying."]</span>
                            }
                        </div>
                    }
                    else if (!CloudAppConfig.IsHideHelpLink)
                    {
                        <div class="take-me-back-to-home-page">
                            @{
#pragma warning disable SCS0029

                            }
                            @Html.Raw(string.Format(T["{0}Go to home page{1} or {2}Create a support ticket{3} with application logs by referring to this {4}link{5}."].Value,
                                $"<span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='{GlobalAppSettings.SystemSettings.BaseUrl}'>",
                                "</a></span>",
                                $"</span><span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='https://support.{GlobalAppSettings.BrandingDomain}/create' target='_blank'>",
                                "</a></span>",
                                $"</span><span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='{await HelpSiteManager.GetHelpSiteUrl(HelpSiteUrlNames.ErrorAndDebugLogs)}' target='_blank'>",
                                "</a></span>"))
                            @{
#pragma warning restore SCS0029

                            }
                        </div>
                    }
                    else
                    {
                        <div class="take-me-back-to-home-page">
                            @{
#pragma warning disable SCS0029

                            }
                            @Html.Raw(string.Format(T["{0}Go to home page{1} or {2}Create a support ticket{3}."].Value,
                                $"<span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='{GlobalAppSettings.SystemSettings.BaseUrl}'>",
                                "</a></span>",
                                $"</span><span class='error-page-cursor'><a class='error-to-back-text-color text-decoration-none' href='https://support.{GlobalAppSettings.BrandingDomain}/create' target='_blank'>",
                                "</a></span>"))
                            @{
#pragma warning restore SCS0029

                            }
                        </div>
                    }
                }
                else
                {
                    <div class="take-me-back-to-home-page">
                        <span class="error-page-cursor"><a class="error-to-back-text-color text-decoration-none" href="@GlobalAppSettings.SystemSettings.BaseUrl">@T["Take me back to home page"]</a></span>
                    </div>
                }
            </div>
        </div>
    </div>
    @if (CloudAppConfig.IsSelfHosted)
    {
        @await Html.PartialAsync("../Shared/_FooterOnPremise")
    }
</body>
</html>
